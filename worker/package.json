{
  "name": "@shajareh/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply shajareh-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shajareh-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"require('fs').writeFileSync('dist-test/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && tsc -p tsconfig.test.json && node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}